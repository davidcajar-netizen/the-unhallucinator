{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session_start.py",
        "timeout": 20
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/before_submit_prompt.py",
        "matcher": "UserPromptSubmit",
        "timeout": 90
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/before_shell.py",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 .cursor/hooks/after_agent_response.py",
        "matcher": "AgentResponse",
        "timeout": 15
      }
    ]
  }
}
